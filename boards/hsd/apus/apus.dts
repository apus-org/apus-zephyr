/dts-v1/;
#include <st/f0/stm32f072Xb.dtsi>
#include <st/f0/stm32f072v(8-b)tx-pinctrl.dtsi>
#include "arduino_r3_connector.dtsi"
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "APUS";
	compatible = "hsd,apus";

	chosen {
		zephyr,console = &usart3;
		zephyr,shell-uart = &usart3;
		zephyr,canbus = &can1;
		zephyr,display = &st7789v;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	leds {
		compatible = "gpio-leds";

		led3: led_3 {
			gpios = <&gpioc 0 GPIO_ACTIVE_LOW>;
			label = "LED3";
		};

		led4: led_4 {
			gpios = <&gpioc 1 GPIO_ACTIVE_LOW>;
			label = "LED4";
		};

		led5: led_5 {
			gpios = <&gpioc 2 GPIO_ACTIVE_LOW>;
			label = "LED5";
		};
	};

	buttons {
		compatible = "gpio-keys";

		user_0_button: button_user_0 {
			gpios = <&gpiod 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "USER0";
			zephyr,code = <INPUT_KEY_0>;
		};

		user_1_button: button_user_1 {
			gpios = <&gpiod 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "USER1";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	wake_up_buttons {
		compatible = "gpio-keys";
		polling-mode;

		wake_up_button: button_wake_up {
			gpios = <&gpioa 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "WAKE_UP";
			zephyr,code = <INPUT_KEY_WAKEUP>;
		};
	};

	mipi_dbi: mipi-dbi {
		compatible = "zephyr,mipi-dbi-bitbang";
		data-gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>,
			     <&gpioe 1 GPIO_ACTIVE_HIGH>,
			     <&gpioe 2 GPIO_ACTIVE_HIGH>,
			     <&gpioe 3 GPIO_ACTIVE_HIGH>,
			     <&gpioe 4 GPIO_ACTIVE_HIGH>,
			     <&gpioe 5 GPIO_ACTIVE_HIGH>,
			     <&gpioe 6 GPIO_ACTIVE_HIGH>,
			     <&gpioe 7 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&gpioe 8 GPIO_ACTIVE_LOW>;
		dc-gpios = <&gpioe 9 GPIO_ACTIVE_HIGH>;
		wr-gpios = <&gpioe 10 GPIO_ACTIVE_HIGH>;
		rd-gpios = <&gpioe 11 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpiof 10 GPIO_ACTIVE_LOW>;
		#address-cells = <1>;
		#size-cells = <0>;

		st7789v: st7789v@0 {
			compatible = "sitronix,st7789v";
			reg = <0>;
			mipi-mode = "MIPI_DBI_MODE_8080_BUS_8_BIT";
			mipi-max-frequency = <DT_FREQ_M(15)>;
			width = <240>;
			height = <320>;
			x-offset = <0>;
			y-offset = <0>;
			vcom = <0x19>;
			gctrl = <0x35>;
			vrhs = <0x12>;
			vdvs = <0x20>;
			mdac = <0x00>;
			gamma = <0x01>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565X>;
			lcm = <0x2c>;
			porch-param = [0c 0c 00 33 33];
			cmd2en-param = [5a 69 02 01];
			pwctrl1-param = [a4 a1];
			pvgam-param = [d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23];
			nvgam-param = [d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23];
			ram-param = [00 f0];
			rgb-param = [cd 08 14];
			inversion-off;
		};
	};

	transceiver0: can-phy0 {
		compatible = "can-transceiver-gpio";
		standby-gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
		max-bitrate = <1000000>;
		#phy-cells = <0>;
	};

	buzzer: buzzer {
		compatible = "gpio-buzzer";
		gpios = <&gpioc 9 GPIO_ACTIVE_LOW>;
	};

	pwmleds {
		compatible = "pwm-leds";

		red_pwm_led: red_pwm_led {
			pwms = <&pwm3 1 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "RGB red";
		};

		green_pwm_led: green_pwm_led {
			pwms = <&pwm3 2 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "RGB green";
		};

		blue_pwm_led: blue_pwm_led {
			pwms = <&pwm3 3 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "RGB blue";
		};
	};

	aliases {
		led0 = &led3;
		led1 = &led4;
		led2 = &led5;
		sw0 = &user_0_button;
		sw1 = &user_1_button;
		sw2 = &wake_up_button;
		pwm-led0 = &red_pwm_led;
		pwm-led1 = &green_pwm_led;
		pwm-led2 = &blue_pwm_led;
		red-pwm-led = &red_pwm_led;
		green-pwm-led = &green_pwm_led;
		blue-pwm-led = &blue_pwm_led;
		buzzer0 = &buzzer;
		ambient-temp0 = &mcp9803;
		eeprom-0 = &eeprom0;
		die-temp0 = &die_temp;
		volt-sensor0 = &vref;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&pll {
	clocks = <&clk_hse>;
	prediv = <1>;
	mul = <6>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(48)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart4 {
	pinctrl-0 = <&usart4_tx_pc10 &usart4_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&timers3 {
	st,prescaler = <479>;
	status = "okay";

	pwm3: pwm {
		pinctrl-0 = <&tim3_ch1_pc6 &tim3_ch2_pc7 &tim3_ch3_pc8>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&can1 {
	pinctrl-0 = <&can_rx_pb8 &can_tx_pb9>;
	pinctrl-names = "default";
	phys = <&transceiver0>;
	status = "okay";
};

zephyr_udc0: &usb {
	pinctrl-0 = <&usb_dm_pa11 &usb_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

&adc1_common {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
};

&adc1 {
	pinctrl-0 = <&adc_in14_pc4>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@e {
		reg = <14>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&dac1 {
	pinctrl-0 = <&dac_out1_pa4>;
	pinctrl-names = "default";
	status = "okay";
};

&die_temp {
	status = "okay";
};

&vref {
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pe13 &spi1_miso_pe14 &spi1_mosi_pe15>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 12 GPIO_ACTIVE_LOW>;
	status = "okay";

	xpt2046: touch@0 {
		compatible = "xptek,xpt2046";
		reg = <0>;
		spi-max-frequency = <375000>;
		int-gpios = <&gpiof 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		touchscreen-size-x = <240>;
		touchscreen-size-y = <320>;
		min-x = <202>;
		min-y = <264>;
		max-x = <3820>;
		max-y = <3837>;
		screen-height = <320>;
		inverted-y;
		reads = <4>;
	};
};

&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	scl-gpios = <&gpiob 6 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpiob 7 GPIO_ACTIVE_HIGH>;
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	mcp9803: mcp9803@48 {
		compatible = "lm75";
		reg = <0x48>;
		int-gpios = <&gpiod 4 GPIO_ACTIVE_LOW>;
	};

	extrtc0: mcp79410@6f {
		compatible = "microchip,mcp7940n";
		reg = <0x6f>;
		int-gpios = <&gpiod 3 GPIO_ACTIVE_LOW>;
		vbat-enable;
	};

	eeprom0: eeprom@57 {
		compatible = "atmel,at24";
		reg = <0x57>;
		size = <128>;
		pagesize = <8>;
		address-width = <8>;
		timeout = <5>;
	};
};
